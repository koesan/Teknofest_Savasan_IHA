<?xml version="1.0"?>
<sdf version="1.5">
  <world name="default">

    <physics type="ode">
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.0</sor>
        </solver>

        <constraints>
          <cfm>0.0</cfm>
          <erp>0.9</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>

      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>-35.3627754</latitude_deg>
      <longitude_deg>149.1658777</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <model name="ground_plane">
      <static>true</static>

      <link name="link">

        <!-- Collision -->
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
        </collision>

        <!-- RUNWAY -->
        <visual name="runway">

          <!-- Daha yukarı kaldırıldı -->
          <pose>0 0 0.15 0 0 0</pose>

          <cast_shadows>false</cast_shadows>

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>240 24</size>
            </plane>
          </geometry>

          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Runway</name>
            </script>
          </material>
        </visual>

        <!-- GRASS -->
        <visual name="grass">
          <pose>0 0 -0.05 0 0 0</pose>

          <cast_shadows>false</cast_shadows>

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>

          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grass</name>
            </script>
          </material>
        </visual>

      </link>
    </model>

    <!-- SUN -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- VTOL -->
    <include>
      <name>standard_vtol</name>
      <pose>0 0 0.5 0 0 0</pose>
      <uri>model://standard_vtol</uri>
    </include>

    <!-- QR TARGET -->
    <include>
      <name>kamikaze_qr_target_1</name>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://kamikaze_qr_target</uri>
    </include>

  </world>
</sdf>