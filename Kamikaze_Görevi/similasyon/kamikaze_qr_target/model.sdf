<?xml version="1.0"?>
<sdf version="1.5">
  <model name="kamikaze_qr_target">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="target_link">
      <self_collide>false</self_collide>
      <kinematic>false</kinematic>
      <gravity>false</gravity>

      <collision name="qr_base_collision">
        <!-- Alt yüzey 0.20m, üst yüzey 0.30m olacak şekilde merkez z=0.25 -->
        <pose>0 0 0.25 0 0 0</pose>
        <geometry>
          <box>
            <size>6.0 6.0 0.10</size>
          </box>
        </geometry>
      </collision>

      <visual name="qr_base_visual">
        <!-- 10 cm kalın taban, yerden biraz yukarıda -->
        <pose>0 0 0.25 0 0 0</pose>
        <geometry>
          <box>
            <size>6.0 6.0 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>

      <visual name="qr_top_visual">
        <!-- QR yüzeyi kalın tabanın üstüne kondu -->
        <pose>0 0 0.301 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>6.0 6.0</size>
          </plane>
        </geometry>
        <material>
          <script>
            <uri>model://kamikaze_qr_target/materials/scripts</uri>
            <uri>model://kamikaze_qr_target/materials/textures</uri>
            <name>KamikazeQR/Top</name>
          </script>
        </material>
        <cast_shadows>false</cast_shadows>
      </visual>
    </link>
  </model>
</sdf>